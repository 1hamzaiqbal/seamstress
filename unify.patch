diff --git a/seamstress/calendar_ics.py b/seamstress/calendar_ics.py
new file mode 100644
--- /dev/null
+++ b/seamstress/calendar_ics.py
@@ -0,0 +1,132 @@
+from __future__ import annotations
+from dataclasses import dataclass
+from datetime import datetime
+from pathlib import Path
+from typing import List, Optional
+
+@dataclass
+class IcsEvent:
+    summary: str
+    start: datetime
+    end: datetime
+    location: str = ""
+    uid: str = ""
+
+def _parse_dt(s: str) -> datetime:
+    # supports 20241107T140000Z and 20241107T140000
+    fmt = "%Y%m%dT%H%M%SZ" if s.endswith("Z") else "%Y%m%dT%H%M%S"
+    return datetime.strptime(s, fmt)
+
+def _fallback_parse_ics(path: Path) -> List[IcsEvent]:
+    lines = [ln.strip() for ln in Path(path).read_text().splitlines()]
+    out: List[IcsEvent] = []
+    rec: dict[str,str] = {}
+    in_event = False
+    for ln in lines:
+        if ln == "BEGIN:VEVENT":
+            in_event, rec = True, {}
+            continue
+        if ln == "END:VEVENT" and in_event:
+            in_event = False
+            out.append(IcsEvent(
+                summary=rec.get("SUMMARY",""),
+                start=_parse_dt(rec["DTSTART"]),
+                end=_parse_dt(rec["DTEND"]),
+                location=rec.get("LOCATION",""),
+                uid=rec.get("UID",""),
+            ))
+            rec = {}
+            continue
+        if in_event and ":" in ln:
+            k,v = ln.split(":",1)
+            rec[k] = v
+    return out
+
+def import_ics(path: Path) -> List[IcsEvent]:
+    """Robust ICS import. Uses `ics` if present, else a tiny fallback parser."""
+    try:
+        from ics import Calendar  # type: ignore
+        cal = Calendar(Path(path).read_text())
+        events: List[IcsEvent] = []
+        for ev in cal.events:
+            start = ev.begin.datetime
+            end = ev.end.datetime
+            events.append(IcsEvent(
+                summary = ev.name or "(untitled)",
+                start = start,
+                end = end,
+                location = getattr(ev, "location", "") or "",
+                uid = getattr(ev, "uid", "") or "",
+            ))
+        return sorted(events, key=lambda e: e.start)
+    except Exception:
+        return sorted(_fallback_parse_ics(path), key=lambda e: e.start)
+
diff --git a/seamstress/focus_offline.py b/seamstress/focus_offline.py
new file mode 100644
--- /dev/null
+++ b/seamstress/focus_offline.py
@@ -0,0 +1,95 @@
+from __future__ import annotations
+import csv
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+from pathlib import Path
+from typing import List
+
+@dataclass
+class Sample:
+    t: datetime
+    keys: int
+    webcam: float
+    @property
+    def score(self)->float:
+        return 0.7*min(self.keys/60,1.0) + 0.3*max(0.0,min(self.webcam,1.0))
+
+@dataclass
+class BreakHint:
+    start: datetime
+    end: datetime
+    reason: str
+
+def load_csv(path: Path) -> List[Sample]:
+    rows: List[Sample] = []
+    with Path(path).open() as fh:
+        r = csv.DictReader(fh)
+        for row in r:
+            rows.append(Sample(
+                t=datetime.fromisoformat(row["timestamp"]),
+                keys=int(row["keystrokes"]),
+                webcam=float(row.get("webcam_focus",0.0)),
+            ))
+    return rows
+
+def analyze(samples: List[Sample],
+            sustained_min: int = 40,
+            low_win_min: int = 8,
+            thresh: float = 0.45) -> List[BreakHint]:
+    out: List[BreakHint] = []
+    if not samples: return out
+    session_start = samples[0].t
+    win: List[Sample] = []
+    for s in samples:
+        win.append(s)
+        # keep last low_win_min worth of samples (assume ~5min cadence typical)
+        while len(win)>=2 and (s.t - win[0].t) >= timedelta(minutes=low_win_min):
+            win.pop(0)
+        if (s.t - session_start) >= timedelta(minutes=sustained_min):
+            avg = sum(x.score for x in win)/len(win) if win else 1.0
+            if avg < thresh:
+                out.append(BreakHint(start=win[0].t, end=s.t,
+                          reason=f"low focus {low_win_min}m window (avg={avg:.2f})"))
+                session_start = s.t
+                win = [s]
+    return out
+
