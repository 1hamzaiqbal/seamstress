+++ b/seamstress/schedule_daily.py
@@ -0,0 +1,122 @@
+from __future__ import annotations
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+from typing import Iterable, List, Dict
+
+BLOCK = timedelta(hours=2)
+RITUAL = timedelta(minutes=30)
+
+@dataclass
+class Block:
+    start: datetime
+    end: datetime
+    label: str
+    source: str  # "thread","routine","calendar","buffer"
+
+def build_simple_schedule(
+    day_start: datetime,
+    projects: Iterable[str],
+    events: Iterable[tuple[datetime, datetime, str]],
+    focus_blocks: int = 3,
+) -> List[Block]:
+    """Round-robin 2h blocks across projects, with 30m morning/evening rituals and calendar overlay."""
+    cur = day_start
+    out: List[Block] = []
+    # Morning ritual
+    out.append(Block(start=cur, end=cur+RITUAL, label="Morning planning", source="routine"))
+    cur += RITUAL
+    # Main focus blocks
+    projects = list(projects) or ["General"]
+    for i in range(focus_blocks):
+        p = projects[i % len(projects)]
+        out.append(Block(start=cur, end=cur+BLOCK, label=f"{p} — 2h sprint", source="thread"))
+        cur += BLOCK
+    # Insert calendar events that overlap [day_start, last_block_end]
+    last_end = cur
+    for (s,e,title) in sorted(events, key=lambda x: x[0]):
+        if e <= day_start or s >= last_end:
+            continue
+        # buffer before event if it splits a work block region
+        if out and out[-1].end < s and out[-1].source!="routine":
+            out.append(Block(start=out[-1].end, end=s, label="Buffer / transit", source="buffer"))
+        out.append(Block(start=max(s,day_start), end=min(e,last_end), label=title, source="calendar"))
+    # Evening ritual
+    out.append(Block(start=cur, end=cur+RITUAL, label="Evening planning", source="routine"))
+    return out
+
