--- a/seamstress/cli.py
+++ b/seamstress/cli.py
@@ -1,0 +1,175 @@
+# Additions to existing Typer CLI (V3). We keep existing commands and append new ones.
+from __future__ import annotations
+from pathlib import Path
+from datetime import datetime
+import json, os, subprocess
+import typer
+from rich.console import Console
+from rich.panel import Panel
+
+from .calendar_ics import import_ics
+from .focus_offline import load_csv, analyze
+from .schedule_daily import build_simple_schedule
+from .storage import load_state
+
+console = Console()
+app = typer.Typer(help="Seamstress productivity companion", add_completion=False)
+
+CONFIG = Path.home()/".seamstress"/"config.json"
+
+def _get_cfg()->dict:
+    if CONFIG.exists():
+        return json.loads(CONFIG.read_text())
+    return {}
+def _set_cfg(d: dict)->None:
+    CONFIG.parent.mkdir(parents=True, exist_ok=True)
+    CONFIG.write_text(json.dumps(d, indent=2))
+
+@app.command("calendar-import-ics")
+def calendar_import_ics(ics_path: Path):
+    """Import and cache a path to an ICS file (no OAuth)."""
+    if not ics_path.exists():
+        console.print(f"[red]Not found:[/red] {ics_path}")
+        raise typer.Exit(1)
+    cfg = _get_cfg()
+    cfg["ics_path"] = str(ics_path.expanduser())
+    _set_cfg(cfg)
+    ev = import_ics(ics_path)
+    console.print(Panel(f"Registered ICS: {ics_path}\nEvents loaded: {len(ev)}", title="Calendar"))
+
+@app.command("visualize-daily")
+def visualize_daily(start: str = typer.Option(..., help="ISO start, e.g. 2025-11-11T09:00"),
+                    focus_blocks: int = 3,
+                    ics_path: Path|None = None,
+                    out: Path = Path("artifacts/daily.png")):
+    """Build a simple 2h‑sprint day with rituals and overlay ICS events. Exports a PNG timeline."""
+    try:
+        import matplotlib.pyplot as plt
+    except Exception:
+        console.print("[red]matplotlib not installed. pip install -e .[viz][/red]")
+        raise typer.Exit(1)
+    start_dt = datetime.fromisoformat(start)
+    state = load_state()
+    projects = list(state.projects.keys()) or ["General"]
+    path = ics_path or Path((_get_cfg().get("ics_path") or "~/.seamstress/calendar.ics")).expanduser()
+    events_raw = []
+    if path.exists():
+        for e in import_ics(path):
+            events_raw.append((e.start, e.end, e.summary))
+    blocks = build_simple_schedule(start_dt, projects, events_raw, focus_blocks)
+    # draw
+    out.parent.mkdir(parents=True, exist_ok=True)
+    fig, ax = plt.subplots(figsize=(11, 3))
+    base = blocks[0].start
+    color = {"thread":"#4C72B0","routine":"#55A868","calendar":"#C44E52","buffer":"#8172B3"}
+    for b in blocks:
+        left = (b.start-base).total_seconds()/3600
+        w = (b.end-b.start).total_seconds()/3600
+        ax.barh([0],[w], left=left, height=0.35, color=color.get(b.source,"#999"), edgecolor="black")
+        ax.text(left+w/2,0,b.label,ha="center",va="center",fontsize=8,color="white" if b.source!="routine" else "black")
+    ax.set_xlabel("Hours from start"); ax.set_yticks([]); ax.set_title(start_dt.strftime("Seamstress — daily plan"))
+    fig.tight_layout(); fig.savefig(out); plt.close(fig)
+    console.print(Panel(f"Saved {out}", title="Daily visualization", border_style="green"))
+
+@app.command("focus-analyze")
+def focus_analyze(csv_path: Path):
+    """Offline analysis of focus CSV (timestamp, keystrokes, webcam_focus). Emits break suggestions."""
+    if not csv_path.exists():
+        console.print(f"[red]Not found:[/red] {csv_path}")
+        raise typer.Exit(1)
+    samples = load_csv(csv_path)
+    hints = analyze(samples)
+    if not hints:
+        console.print("No break suggestions.")
+        return
+    for h in hints:
+        console.print(f"{h.start:%H:%M}–{h.end:%H:%M} | {h.reason}")
+
+@app.command("streamlit")
+def streamlit_dashboard():
+    """Launch the local Streamlit dashboard (no cloud deps)."""
+    import importlib.util, sys
+    if importlib.util.find_spec("streamlit") is None:
+        console.print("[red]streamlit not installed. pip install -e .[gui][/red]")
+        raise typer.Exit(1)
+    mod = Path(__file__).parent/"app_streamlit"/"dashboard.py"
+    subprocess.run(["streamlit","run", str(mod)], check=False)
+
