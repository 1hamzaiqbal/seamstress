+from __future__ import annotations
+from datetime import datetime, timedelta
+from pathlib import Path
+import pandas as pd
+import streamlit as st
+from ..storage import load_state
+from ..calendar_ics import import_ics
+
+st.set_page_config(page_title="Seamstress", layout="wide")
+
+def _project_df(state):
+    rows = []
+    for name, goal in state.projects.items():
+        rows.append({
+            "Project": name,
+            "Weekly target (h)": goal.weekly_target_hours,
+        })
+    return pd.DataFrame(rows)
+
+def _capsules_df(state):
+    rows=[]
+    for c in state.time_capsules:
+        rows.append({"Project": c.project, "When": c.created_at, "Summary": c.summary})
+    return pd.DataFrame(rows).sort_values("When", ascending=False)
+
+def _ics_df(ics_path: Path|None):
+    if not ics_path or not ics_path.exists():
+        return pd.DataFrame()
+    ev = import_ics(ics_path)
+    return pd.DataFrame([{
+        "Title": e.summary, "Start": e.start, "End": e.end, "Location": e.location
+    } for e in ev])
+
+def main():
+    st.title("Seamstress Control Board")
+    state = load_state()
+    left, right = st.columns([2,1])
+    with left:
+        st.subheader("Projects")
+        st.dataframe(_project_df(state), hide_index=True)
+        st.subheader("Time Capsules")
+        st.dataframe(_capsules_df(state), hide_index=True)
+    with right:
+        st.subheader("Calendar (ICS)")
+        ics_path = st.text_input("ICS path", value=str(Path("~/.seamstress/calendar.ics").expanduser()))
+        if st.button("Load ICS"):
+            df = _ics_df(Path(ics_path).expanduser())
+            if df.empty:
+                st.info("No events loaded.")
+            else:
+                st.dataframe(df, hide_index=True, height=320)
+
+if __name__ == "__main__":
+    main()
+
